<?xml version="1.0"?>
<ruleset name="SEO Console">
	<description>WordPress Coding Standards + PHP 7.4 compatibility for SEO Console.</description>
	<file>./seo-console.php</file>
	<file>./uninstall.php</file>
	<file>./includes</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 file names (Foo/BarBaz.php) instead of class-bar-baz.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array"><element value="seo-console"/></property></properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties><property name="prefixes" type="array"><element value="seoc"/><element value="SEOConsole"/></property></properties>
	</rule>
</ruleset>

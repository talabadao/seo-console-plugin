{
    "name": "artemisdigital/seo-console",
    "description": "SEO Console for WordPress: technical SEO audit, page speed, AI suggestions with human approval.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "woocommerce/action-scheduler": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.8",
        "johnpbloch/wordpress-core": "^6.8",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^6.8"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "johnpbloch/wordpress-core-installer": false
        },
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    },
    "extra": {
        "installer-paths": {
            "vendor/{$vendor}/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    }
}
